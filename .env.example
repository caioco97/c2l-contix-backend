# Copie para .env e ajuste os valores: cp .env.example .env

# Ambiente ASP.NET Core: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_DB=contix
POSTGRES_USER=contix
POSTGRES_PASSWORD=contix
POSTGRES_PORT=5432

# API
API_PORT=5080
# Chave de assinatura do JWT (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SIGNING_KEY=troque-esta-chave-por-um-valor-aleatorio-com-48-caracteres
# Origem do frontend liberada no CORS
FRONTEND_URL=http://localhost:5173

# Inicialização do banco
DB_MIGRATE_ON_STARTUP=true
# Cria escritório, usuários e empresa de demonstração (não use em produção)
DB_SEED_DEMO=true
SWAGGER_ENABLED=true

# E-mail (recuperação de senha e notificações)
# Em desenvolvimento os e-mails vão para o Mailpit: http://localhost:8025
EMAIL_PROVIDER=Smtp
EMAIL_REMETENTE=nao-responda@contix.dev
SMTP_HOST=mailpit
SMTP_PORT=1025
# None | StartTls | SslOnConnect
SMTP_SEGURANCA=None
SMTP_USUARIO=
SMTP_SENHA=
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
