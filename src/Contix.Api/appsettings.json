{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=contix;Username=contix;Password=contix"
  },
  "Jwt": {
    "Issuer": "contix-api",
    "Audience": "contix-web",
    "SigningKey": "",
    "AccessTokenMinutos": 15,
    "RefreshTokenDias": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalPath": "storage"
  },
  "Documentos": {
    "TamanhoMaximoMb": 25,
    "MaximoArquivosPorUpload": 20,
    "ClientePodeExcluirProprios": true
  },
  "Notificacoes": {
    "UrlFrontend": "http://localhost:5173",
    "ValidadeLinkRedefinicaoMinutos": 60,
    "ValidadeConviteDias": 7,
    "LembreteVencimento": {
      "Habilitado": true,
      "IntervaloMinutos": 60
    }
  },
  "Email": {
    "Provider": "Log",
    "Remetente": "nao-responda@contix.dev",
    "NomeRemetente": "Contix",
    "Smtp": {
      "Host": "localhost",
      "Porta": 1025,
      "Seguranca": "None",
      "Usuario": null,
      "Senha": null
    },
    "ProcessarFila": true,
    "IntervaloFilaSegundos": 10,
    "LoteFila": 20
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*"
}
