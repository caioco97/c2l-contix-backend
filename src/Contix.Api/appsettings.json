{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=contix;Username=contix;Password=contix"
  },
  "Jwt": {
    "Issuer": "contix-api",
    "Audience": "contix-web",
    "SigningKey": "",
    "AccessTokenMinutos": 15,
    "RefreshTokenDias": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalPath": "storage"
  },
  "Documentos": {
    "TamanhoMaximoMb": 25,
    "MaximoArquivosPorUpload": 20,
    "ClientePodeExcluirProprios": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*"
}
